{
  "manifest_version": 3,
  "name": "Contribution Lands",
  "description": "Turns the contribution graph on GitHub profile pages into an isometric New York skyline, with streaks, stats and landmarks.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "homepage_url": "https://jeanluciradukunda.github.io/contribution-lands/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "Contribution Lands",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["themes/*/theme.json", "themes/*/sprites/*.png", "themes/*/sprites/manifest.json"],
      "matches": ["https://github.com/*"]
    }
  ]
}
